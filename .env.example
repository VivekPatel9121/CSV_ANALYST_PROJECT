# Application environment
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# Required in production. Generate a unique value with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# APP_ACCESS_TOKEN=

# Paths
# DATA_DIR=./data
# UPLOAD_DIR=./uploads
# REPORTS_DIR=./reports
# DATABASE_URL=sqlite:///./data/app.db

# Uploads
# MAX_UPLOAD_SIZE_MB=25
# MAX_ROWS=1000000

# CORS (comma-separated)
# CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Logging
# LOG_LEVEL=INFO
# LOG_FILE=

# OpenAI
# Users should enter their key in the browser; it is sent per-request via
# X-AI-API-Key and is not stored on the server.
# OPENAI_API_KEY=
# OPENAI_API_URL=https://api.openai.com/v1/chat/completions
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_FALLBACK_MODEL=
# OPENAI_TIMEOUT_SECONDS=60
# OPENAI_MAX_RETRIES=2
# OPENAI_MAX_CONTEXT_TOKENS=9000
# OPENAI_AI_INSIGHTS_TOKENS=1200

# Chat
# CHAT_HISTORY_LIMIT=10
# CHAT_DATA_CONTEXT_BUDGET=4000
# CHAT_HISTORY_BUDGET=2000
# CHAT_TOTAL_BUDGET=8000
# CHAT_MAX_SAMPLE_VALUES=5

# Rate limiting (per IP)
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_MAX_REQUESTS=30
# RATE_LIMIT_WINDOW_SECONDS=60
